{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "verify": "tsx tools/verify-invariants.mts && tsx tools/verify-render.mts && tsx tools/verify-stage-colors.mts && tsx tools/verify-insights.mts && tsx tools/verify-animation-transform.mts && tsx tools/verify-rhythm.mts && tsx tools/verify-ai-advice.mts && tsx tools/verify-copy.mts",
    "verify:theme": "tsx tools/verify-theme-classes.mts",
    "verify:data": "tsx tools/verify-invariants.mts",
    "verify:render": "tsx tools/verify-render.mts",
    "verify:colors": "tsx tools/verify-stage-colors.mts",
    "check": "npm run lint && npm run build && npm run verify:total",
    "verify:insights": "tsx tools/verify-insights.mts",
    "verify:animation": "tsx tools/verify-animation-transform.mts",
    "verify:rhythm": "tsx tools/verify-rhythm.mts",
    "verify:ai": "tsx tools/verify-ai-advice.mts",
    "verify:total": "node tools/assertion-total.mjs",
    "verify:copy": "tsx tools/verify-copy.mts"
  },
  "dependencies": {
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@wllama/wllama": "^3.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
